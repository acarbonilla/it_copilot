# Copy this file to .env for local development. Never commit .env.
COMPOSE_PROJECT_NAME=it-support-copilot

# Local MySQL only; replace these development placeholders in your private .env.
MYSQL_DATABASE=it_support_copilot
MYSQL_USER=it_copilot
MYSQL_PASSWORD=local-development-only
MYSQL_ROOT_PASSWORD=local-root-development-only
MYSQL_PORT=3306

# Native Windows MySQL settings used by apps/api (Docker remains optional).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
MYSQL_HOST=127.0.0.1
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=5
MYSQL_WRITE_TIMEOUT=5

# Reserved for the future web application.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

